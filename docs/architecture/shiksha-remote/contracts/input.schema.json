{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shikshacom.com/schemas/remote-control/input.v1.json",
  "title": "Shiksha Remote control \u2014 controller input envelope v1",
  "description": "Frozen by RC-002 from realtime-event-contracts.md. Producers in Python, JS and Rust MUST validate against this and MUST NOT add fields. Limits JSON Schema cannot express \u2014 UTF-8 byte ceilings, per-topic packet sizes, rate limits, sequence monotonicity, challenge freshness \u2014 live in reference_validator.py and are part of the contract, not optional extras.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "grant_id",
    "epoch",
    "seq",
    "challenge",
    "capture_generation",
    "kind",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "base64url, unpadded, 128-bit native nonce"
    },
    "capture_generation": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "move",
        "button",
        "wheel",
        "key",
        "text",
        "reset",
        "heartbeat"
      ]
    },
    "body": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "move"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "u": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "v": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "u",
              "v"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "button"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "button": {
                "enum": [
                  "left",
                  "middle",
                  "right"
                ]
              },
              "down": {
                "type": "boolean"
              },
              "u": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "v": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "motion_seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "button",
              "down",
              "u",
              "v",
              "motion_seq"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "wheel"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "dx": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "dy": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "u": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "v": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "motion_seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "dx",
              "dy",
              "u",
              "v",
              "motion_seq"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "key"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "KeyA",
                  "KeyB",
                  "KeyC",
                  "KeyD",
                  "KeyE",
                  "KeyF",
                  "KeyG",
                  "KeyH",
                  "KeyI",
                  "KeyJ",
                  "KeyK",
                  "KeyL",
