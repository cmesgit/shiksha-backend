                  "F4",
                  "F5",
                  "F6",
                  "F7",
                  "F8",
                  "F9",
                  "F10",
                  "F11",
                  "F12",
                  "Backquote",
                  "Minus",
                  "Equal",
                  "BracketLeft",
                  "BracketRight",
                  "Backslash",
                  "Semicolon",
                  "Quote",
                  "Comma",
                  "Period",
                  "Slash",
                  "IntlBackslash",
                  "Space",
                  "Enter",
                  "Tab",
                  "Backspace",
                  "Delete",
                  "Insert",
                  "Home",
                  "End",
                  "PageUp",
                  "PageDown",
                  "ArrowLeft",
                  "ArrowRight",
                  "ArrowUp",
                  "ArrowDown",
                  "Escape",
                  "ShiftLeft",
                  "ShiftRight",
                  "ControlLeft",
                  "ControlRight",
                  "AltLeft",
                  "AltRight",
                  "MetaLeft",
                  "MetaRight",
                  "CapsLock",
                  "NumLock",
                  "NumpadAdd",
                  "NumpadSubtract",
                  "NumpadMultiply",
                  "NumpadDivide",
                  "NumpadDecimal",
                  "NumpadEnter"
                ]
              },
              "down": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "down"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reset"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "reason": {
                "enum": [
                  "blur",
                  "visibility",
                  "pointer_cancel",
                  "user_pause"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "enum": [
                    "KeyA",
                    "KeyB",
                    "KeyC",
                    "KeyD",
                    "KeyE",
                    "KeyF",
                    "KeyG",
                    "KeyH",
                    "KeyI",
