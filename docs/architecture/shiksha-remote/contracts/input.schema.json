                    "F10",
                    "F11",
                    "F12",
                    "Backquote",
                    "Minus",
                    "Equal",
                    "BracketLeft",
                    "BracketRight",
                    "Backslash",
                    "Semicolon",
                    "Quote",
                    "Comma",
                    "Period",
                    "Slash",
                    "IntlBackslash",
                    "Space",
                    "Enter",
                    "Tab",
                    "Backspace",
                    "Delete",
                    "Insert",
                    "Home",
                    "End",
                    "PageUp",
                    "PageDown",
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowUp",
                    "ArrowDown",
                    "Escape",
                    "ShiftLeft",
                    "ShiftRight",
                    "ControlLeft",
                    "ControlRight",
                    "AltLeft",
                    "AltRight",
                    "MetaLeft",
                    "MetaRight",
                    "CapsLock",
                    "NumLock",
                    "NumpadAdd",
                    "NumpadSubtract",
                    "NumpadMultiply",
                    "NumpadDivide",
                    "NumpadDecimal",
                    "NumpadEnter"
                  ]
                },
                "maxItems": 16
              },
              "buttons": {
                "type": "array",
                "items": {
                  "enum": [
                    "left",
                    "middle",
                    "right"
                  ]
                },
                "maxItems": 3
              },
              "last_ack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "keys",
              "buttons",
              "last_ack"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ],
