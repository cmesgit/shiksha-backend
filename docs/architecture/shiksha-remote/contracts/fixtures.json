    "bad_version": "v is not exactly 1",
    "bad_uuid": "not a lowercase canonical UUID string",
    "bad_seq": "not an integer in 1..2^53-1",
    "out_of_range": "numeric or enum value outside its contract bounds",
    "unsupported_key": "DOM code outside the frozen 101-entry allowlist",
    "too_many": "array longer than its contract maximum",
    "text_too_long": "over 256 Unicode scalars or 1024 UTF-8 bytes",
    "control_char": "NUL or a control character other than LF/TAB",
    "bad_challenge": "not 22 unpadded base64url characters",
    "oversize": "serialised packet exceeds its topic's byte ceiling",
    "bad_body": "body is not an object",
    "bad_json": "not decodable JSON, or carries a non-finite literal",
    "bad_encoding": "raw bytes are not valid UTF-8"
